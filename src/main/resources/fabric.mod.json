{
  "schemaVersion": 1,
  "id": "skyland",
  "version": "${version}",
  "name": "NetherSkyBlock",
  "description": "A Mod for Minecraft Nether SkyBlock",
  "authors": [
    "Nether-Power"
  ],
  "contact": {
    "sources": "https://github.com/XXiuBai/Nether_Sky_Block",
    "issues": "https://github.com/XXiuBai/Nether_Sky_Block/issues"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.dubhe.skyland.SkyLandMod"
    ],
    "fabric-datagen": [
      "dev.dubhe.skyland.data.SkyLandDataGenerator"
    ],
    "jade": [
      "dev.dubhe.skyland.plugin.ComposterPlugin"
    ]
  },
  "mixins": [
    "skyland.mixins.json",
    {
      "config": "skyland.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "skyland.accesswidener",
  "depends": {
    "minecraft": ">=26.1.2",
    "fabricloader": "*",
    "fabric-api": "*"
  }
}
